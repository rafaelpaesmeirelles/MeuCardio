/* Painel diário inserido apenas no espaço já existente abaixo do CorVIA Intelligence. */
.ccc-home__intelligence > .ccc-pending-actions-card{
  margin-top:12px;
  padding:14px;
  background:linear-gradient(180deg,rgba(13,34,57,.98),rgba(8,26,44,.98));
  border:1px solid rgba(99,178,229,.16);
  box-shadow:0 16px 34px rgba(2,10,20,.18);
}
.ccc-pending-actions-card__header{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}
.ccc-pending-actions-card__header>span{display:flex;min-width:0;align-items:center;gap:7px;color:#eef8ff;font-size:.74rem;font-weight:800;letter-spacing:-.01em}
.ccc-pending-actions-card__header>span svg{width:16px;height:16px;color:#74e6e9}
.ccc-pending-actions-card__header>a{flex:0 0 auto;color:#70dbe8;font-size:.64rem;font-weight:760;text-decoration:none}
.ccc-pending-actions-card__header>a:hover{text-decoration:underline}
.ccc-pending-actions-card__list{display:grid;gap:6px}
.ccc-pending-actions-card__item{display:grid;grid-template-columns:29px minmax(0,1fr) 16px;align-items:center;gap:8px;min-height:45px;padding:7px 8px;color:inherit;text-decoration:none;background:rgba(12,39,63,.68);border:1px solid rgba(100,175,221,.12);border-radius:10px;transition:border-color .15s ease,background-color .15s ease,transform .15s ease}
.ccc-pending-actions-card__item:hover{background:rgba(16,51,81,.88);border-color:rgba(76,213,225,.30);transform:translateY(-1px)}
.ccc-pending-actions-card__icon{display:grid;width:29px;height:29px;place-items:center;border-radius:8px;color:#74e6e9;background:rgba(48,183,211,.10);border:1px solid rgba(88,213,226,.12)}
.ccc-pending-actions-card__icon svg{width:15px;height:15px}
.ccc-pending-actions-card__copy{display:grid;min-width:0;gap:2px}
.ccc-pending-actions-card__copy strong{overflow:hidden;color:#e9f5fc;font-size:.67rem;font-weight:760;line-height:1.16;text-overflow:ellipsis;white-space:nowrap}
.ccc-pending-actions-card__copy small{overflow:hidden;color:#86a3b7;font-size:.57rem;line-height:1.15;text-overflow:ellipsis;white-space:nowrap}
.ccc-pending-actions-card__arrow{width:14px;height:14px;color:#7897aa;transition:transform .15s ease,color .15s ease}
.ccc-pending-actions-card__item:hover .ccc-pending-actions-card__arrow{color:#74e6e9;transform:translateX(2px)}
@media(max-width:1100px){.ccc-home__intelligence>.ccc-pending-actions-card{display:none!important}}
