{
  "name": "meucardio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:scientific-environment-contract": "node --test scripts/check-scientific-learning-environment-contract.test.mjs",
    "test:heart-team-frontend-contract": "node --test scripts/check-heart-team-frontend-contract.test.mjs",
    "test:whatsapp-frontend-contract": "node --test scripts/check-whatsapp-frontend-contract.test.mjs",
    "test:cardiology-spaces-home-contract": "node --test scripts/check-cardiology-spaces-home-contract.test.mjs",
    "test:cardiology-spaces-route-coverage": "node scripts/check-cardiology-spaces-route-coverage.mjs",
    "audit:security": "node scripts/audit-dependencies.mjs",
