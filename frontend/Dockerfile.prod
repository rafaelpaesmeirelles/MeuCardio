# Build de produção: compila os arquivos estáticos e para. Não serve nada
# sozinho — o serviço "caddy" do docker-compose.prod.yml lê o resultado
# direto do volume compartilhado "sitefiles".
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL=/api
ARG VITE_DEPLOY_COMMIT=unknown
ARG VITE_CARDIOLOGY_SPACES_ENABLED=true
ARG VITE_HEART_TEAM_ENABLED=true
ARG VITE_WHATSAPP_ASSISTANT_ENABLED=true
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_DEPLOY_COMMIT=${VITE_DEPLOY_COMMIT}
ENV VITE_CARDIOLOGY_SPACES_ENABLED=${VITE_CARDIOLOGY_SPACES_ENABLED}
ENV VITE_HEART_TEAM_ENABLED=${VITE_HEART_TEAM_ENABLED}
ENV VITE_WHATSAPP_ASSISTANT_ENABLED=${VITE_WHATSAPP_ASSISTANT_ENABLED}
RUN npm run build

FROM alpine:3.20
COPY --from=build /app/dist /dist
CMD ["sh", "-c", "rm -rf /site/* && cp -r /dist/* /site/ && echo 'build copiado para /site'"]
