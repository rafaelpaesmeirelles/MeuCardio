POSTGRES_USER=meucardio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=meucardio
# DATABASE_URL não é definido aqui de propósito — o sistema monta ele sozinho
# a partir das três linhas acima. Só defina isso manualmente se o banco não
# rodar no container "db" padrão (ex.: banco externo).
REDIS_URL=redis://redis:6379/0
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=720
CONTENT_DIR=/content
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha

# Em produção a API e o site ficam no mesmo domínio via Caddy, então CORS
# praticamente não entra em jogo; mantido por segurança e para o /api/docs.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://seudominio.com.br

# --- IA clínica ---------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=openai          # trocar para "anthropic" quando o crédito OpenAI acabar
AI_DAILY_LIMIT=50
AI_TOP_K=8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini              # confirme o identificador no painel da OpenAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                    # precisa bater com o modelo de embedding

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Produção (docker-compose.prod.yml) ---------------------------------
# Registro DNS tipo A já apontado para o IP do servidor antes de subir.
DOMAIN=seudominio.com.br
