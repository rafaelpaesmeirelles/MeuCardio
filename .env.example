# Em desenvolvimento local, mantenha development. O compose de produção
# sobrescreve este valor para production e ativa validações fail-fast.
ENVIRONMENT=development

POSTGRES_USER=meucardio
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=meucardio
# DATABASE_URL não é definido aqui de propósito — o sistema monta ele sozinho
# a partir das três linhas acima. Só defina isso manualmente se o banco não
# rodar no container "db" padrão (ex.: banco externo).
REDIS_URL=redis://redis:6379/0
JWT_SECRET=gere-com-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=720
CONTENT_DIR=/content
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha
STORAGE_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://seudominio.com.br

# --- Agenda, trânsito, mapas e sincronização contínua -------------------
# Em produção docker-compose.prod.yml força o supervisor ligado e executa uma
# rodada a cada 60s. E-mail externo é proxy ao vivo; o supervisor mantém a
# credencial/refresh token saudável e sincroniza calendário/contatos.
AGENDA_BACKGROUND_SYNC_ENABLED=true
AGENDA_SYNC_INTERVAL_SECONDS=60
# A chave de Routes é privada: restrinja ao IP do servidor e somente à Routes API.
TRAFFIC_PROVIDER=google_routes
GOOGLE_ROUTES_API_KEY=
# A chave do navegador é pública: restrinja por HTTP referrer ao domínio do
# sistema e somente à Maps JavaScript API. Não reutilize a chave acima.
GOOGLE_MAPS_BROWSER_API_KEY=

# OAuth de agenda, contatos e e-mail. Cadastre exatamente os callbacks:
# https://corvia.med.br/api/agenda/oauth/google/callback
# https://corvia.med.br/api/agenda/oauth/microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# true SOMENTE enquanto o projeto OAuth Google estiver de fato em Testing.
# Para lançamento público/persistente, depois de concluir a publicação/
# verificação no Google Cloud, defina false. O próprio Google limita refresh
# tokens de apps External em Testing quando há escopos além de perfil básico.
GOOGLE_OAUTH_MODO_TESTE=true
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- Login externo da conta CorVIA -------------------------------------
# Os botões aparecem somente para provedores realmente configurados. O fluxo
# não cria usuário nem contorna aprovação/KYC/assinatura: o e-mail confirmado
# pelo provedor deve corresponder a uma conta CorVIA existente e aprovada.
# Google/Microsoft podem reutilizar as credenciais acima; estes pares dedicados
# são opcionais quando você quiser separar login dos escopos de agenda/e-mail.
# Callbacks:
# https://corvia.med.br/api/auth/social/google/callback
# https://corvia.med.br/api/auth/social/microsoft/callback
# https://corvia.med.br/api/auth/social/apple/callback
# https://corvia.med.br/api/auth/social/yahoo/callback
# https://corvia.med.br/api/auth/social/github/callback
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=
MICROSOFT_SIGNIN_CLIENT_ID=
MICROSOFT_SIGNIN_CLIENT_SECRET=
MICROSOFT_SIGNIN_TENANT=common
# Sign in with Apple exige Services ID + Team ID + Key ID + private key .p8.
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
# Em .env pode ser PEM multilinha real ou string com \n literais.
APPLE_SIGNIN_PRIVATE_KEY=
YAHOO_SIGNIN_CLIENT_ID=
YAHOO_SIGNIN_CLIENT_SECRET=
GITHUB_SIGNIN_CLIENT_ID=
GITHUB_SIGNIN_CLIENT_SECRET=

# --- IA clínica ---------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER=openai
# ECG de paciente só pode sair do cofre para o provedor quando esta capability
# for habilitada conscientemente no ambiente.
AI_CLINICAL_MULTIMODAL_ENABLED=false
AI_ECG_MODEL=
AI_DAILY_LIMIT=50
AI_TOP_K=8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Desligada por padrão: dá ao assistente acesso a ferramentas que agem sobre
# a agenda e o CorvIA Mail do próprio médico, não só texto. Exige também
# consentimento individual do médico (users.ia_ferramentas_consent_em) — as
# duas condições, não uma ou outra. Ver docs/adr-assistente-ferramentas.md.
AI_ASSISTANT_TOOLS_ENABLED=false

# --- E-mail transacional ------------------------------------------------
# `auto` prefere a conta Native institucional no Mail360 e usa SMTP apenas
# como alternativa se o Mail360 transacional não estiver configurado.
# Em produção CorVIA, use explicitamente `mail360` para evitar fallback
# acidental para uma configuração SMTP antiga.
EMAIL_TRANSACIONAL_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CorVIA <contato@corvia.med.br>
PUBLIC_URL=https://corvia.med.br

# --- CorvIA Mail / Mail360 ---------------------------------------------
# Preencha SOMENTE no secret store ou no .env do servidor. Nunca comite valores
# reais. Depois de alterar, reinicie o backend e execute o diagnóstico seguro:
# POST /api/mail360-status/admin/probe
MAIL360_CLIENT_ID=
MAIL360_CLIENT_SECRET=
MAIL360_REFRESH_TOKEN=
MAIL360_DOMINIO=corvia.med.br
# account_key da caixa Native institucional contato@corvia.med.br. Não é token
# OAuth e nunca deve ser mostrado no diagnóstico/admin, embora permaneça fora
# do Git por ser configuração específica do ambiente.
MAIL360_TRANSACTIONAL_ACCOUNT_KEY=
CORVIA_MAIL_PRECO_CENTAVOS=0

# Alternativa SMTP opcional (ex.: Resend). Só preencha se escolher
# EMAIL_TRANSACIONAL_PROVIDER=smtp. Na Resend: host smtp.resend.com,
# usuário literal `resend` e API key como SMTP_PASSWORD.

# --- Stripe -------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=
SUBSCRIPTIONS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Produção (docker-compose.prod.yml) ---------------------------------
DOMAIN=seudominio.com.br

