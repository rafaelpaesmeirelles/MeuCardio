"""Concessão administrativa de acesso — issue #52, nova frente de entitlement.

Origem: bug real em produção — `drmarciopeixoto@corvia.med.br`, marcado
`User.convidado = True` pelo admin, continuou sendo bloqueado com "assinatura
necessária" ao tentar usar o sistema. Causa raiz: `assinante_ativo()`
(`app/core/security.py`, o gate central aplicado por router em
`app/main.py`) só verifica `Subscription.status` — nunca olha
`User.convidado`. O bypass de cobrança do convidado vivia inteiramente
dentro de `criar_checkout()` (`app/api/billing.py`), que só roda quando o
usuário VISITA a tela de Assinatura e clica em "Assinar". Um convidado que
loga e vai direto para qualquer outra tela nunca aciona esse caminho, e o
gate central o barra do mesmo jeito que barraria um visitante sem conta.

Esta tabela substitui esse acoplamento por uma fonte única e explícita:
`app/services/entitlement.py::decidir_acesso()` é o ÚNICO lugar que decide
se um usuário tem acesso — `assinante_ativo()` chama essa função, não
implementa a própria regra. Qualquer gate futuro (rota nova, frontend) deve
consultar a mesma decisão, nunca reimplementar a checagem.

`tipo` é o vocabulário de origem do acesso — extensível para casos futuros
sem migração de schema nova (cortesia de parceiro, patrocinador etc.), só
adicionando ao conjunto abaixo:
"""
from __future__ import annotations

from datetime import datetime, timezone

from sqlalchemy import Boolean, DateTime, ForeignKey, String, Text
from sqlalchemy.orm import Mapped, mapped_column

from app.core.db import Base

TIPO_MEDICO_CONVIDADO = "medico_convidado"
TIPO_INVESTIDOR_DEMO = "investidor_demo"
TIPOS_GRANT_PERMITIDOS = frozenset({TIPO_MEDICO_CONVIDADO, TIPO_INVESTIDOR_DEMO})


class AccessGrant(Base):
    """Concessão de acesso sem pagamento, por decisão administrativa —
    nunca criada pelo próprio usuário, sempre com trilha de auditoria."""

    __tablename__ = "access_grants"

    id: Mapped[int] = mapped_column(primary_key=True)

    # Um grant ATIVO por usuário — não há caso de uso hoje para acumular mais
    # de um simultâneo (o índice parcial permite reconceder depois de
    # revogar, igual ao padrão já usado em `subscriptions`).
    user_id: Mapped[int] = mapped_column(ForeignKey("users.id"), index=True)

    tipo: Mapped[str] = mapped_column(String(40))
    plano: Mapped[str] = mapped_column(String(20))  # PLANO_BASICO | PLANO_COMPLETO, ver app/models/subscription.py

    ativo: Mapped[bool] = mapped_column(Boolean, default=True, index=True)

    concedido_por_user_id: Mapped[int] = mapped_column(ForeignKey("users.id"))
    concedido_em: Mapped[datetime] = mapped_column(
        DateTime(timezone=True), default=lambda: datetime.now(timezone.utc)
    )

    # Nulo = sem validade definida (caso normal do convidado/investidor,
    # revogação é sempre manual). Quando preenchido, `decidir_acesso()` trata
    # como expirado a partir deste instante, sem precisar de job/cron —
    # comparação feita na hora da decisão, não um estado gravado.
    expira_em: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)

    revogado_em: Mapped[datetime | None] = mapped_column(DateTime(timezone=True), nullable=True)
    revogado_por_user_id: Mapped[int | None] = mapped_column(ForeignKey("users.id"), nullable=True)

    nota: Mapped[str | None] = mapped_column(Text, nullable=True)

    def expirado(self, agora: datetime | None = None) -> bool:
        if self.expira_em is None:
            return False
        referencia = agora or datetime.now(timezone.utc)
        return referencia >= self.expira_em
