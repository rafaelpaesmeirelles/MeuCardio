# Corvia — domínio único.
#
# meucardio.med.br foi DESLIGADO, não redirecionado: a marca anterior está
# registrada por outro titular, e manter o domínio no ar servindo ou
# apontando para cá prolongaria o uso do nome. Decisão do Rafael, por risco
# jurídico — não por questão técnica.
#
# Consequência assumida: link antigo, favorito e o app Android já instalado
# deixam de resolver. Foi conferido antes de desligar que não havia
# assinante pagante nem usuário além do administrador, e o app novo está
# sendo gerado com o domínio novo.
{$DOMAIN}, www.{$DOMAIN} {
	encode gzip zstd

	# API e documentação do backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Galeria de imagens — arquivo estático, servido direto (não passa pelo backend)
	handle_path /galeria/* {
		root * /galeria
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	# Foto de perfil enviada pelo usuário. Volume somente-leitura aqui: quem
	# grava é o backend. Cache curto porque a foto pode ser trocada — o nome do
	# arquivo já muda a cada envio, mas o curto evita foto velha após remoção.
	handle_path /fotos/* {
		root * /uploads/fotos
		file_server
		header Cache-Control "public, max-age=300"
	}

	# Logo pessoal do médico (Tarefa 29), usado no cabeçalho de receita e
	# documento além da logo da Corvia — mesmo padrão de /fotos acima.
	handle_path /logos/* {
		root * /uploads/logos
		file_server
		header Cache-Control "public, max-age=300"
	}

	# Arquivos com hash no nome (Vite): podem ser cacheados por muito tempo,
	# porque qualquer mudança de conteúdo já vem com um nome de arquivo novo.
	# Bloco à parte, e não `header /assets/* ...` dentro do handle abaixo,
	# porque testado que o matcher de path embutido no `header` não se impõe
	# sobre um `header` sem matcher no mesmo bloco — o padrão geral vencia
	# mesmo para requisição de asset.
	handle_path /assets/* {
		root * /site/assets
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# PWA: arquivos estáticos, com fallback para index.html (rotas do React
	# Router). Cache-Control "no-cache" é o que corrige a raiz do problema:
	# index.html, sw.js e o manifest não tinham Cache-Control nenhum (só
	# ETag/Last-Modified), e o navegador podia aplicar cache heurístico e
	# continuar rodando o bundle antigo por um tempo mesmo após um rebuild,
	# porque nunca chegava a revalidar.
	handle {
		root * /site
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
