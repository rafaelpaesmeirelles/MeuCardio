# Dois domínios no mesmo bloco durante a migração de marca. O Caddy emite e
# renova certificado para ambos por ACME, então não existe janela em que um
# deles fique sem TLS válido — que é justamente o risco de trocar o DNS antes
# de ter o certificado emitido.
#
# `{$DOMAIN}` continua vindo do .env e hoje é meucardio.med.br. Quando a
# migração estiver confirmada, ele passa a ser corvia.med.br e o antigo vira
# redirecionamento — não desligamento.
#
# `www` entra porque o DNS já resolve para cá: sem estar no bloco, o Caddy não
# tem certificado para ele e quem digita com www recebe erro de conexão, não
# uma página. Domínio que resolve e não é atendido é pior do que domínio que
# não resolve.
{$DOMAIN}, {$DOMAIN_NOVO}, www.{$DOMAIN_NOVO} {
	encode gzip zstd

	# API e documentação do backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Galeria de imagens — arquivo estático, servido direto (não passa pelo backend)
	handle_path /galeria/* {
		root * /galeria
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	# Foto de perfil enviada pelo usuário. Volume somente-leitura aqui: quem
	# grava é o backend. Cache curto porque a foto pode ser trocada — o nome do
	# arquivo já muda a cada envio, mas o curto evita foto velha após remoção.
	handle_path /fotos/* {
		root * /uploads/fotos
		file_server
		header Cache-Control "public, max-age=300"
	}

	# PWA: arquivos estáticos, com fallback para index.html (rotas do React Router)
	handle {
		root * /site
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
