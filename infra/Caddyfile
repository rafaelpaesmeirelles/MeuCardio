# CorVIA Cardiology Spaces — domínio único.
{$DOMAIN}, www.{$DOMAIN} {
	encode gzip zstd

	# API nunca é cacheada pelo proxy do site. A aplicação também usa
	# `cache: no-store`/NetworkOnly para as rotas de dados dinâmicos.
	handle /api/* {
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		reverse_proxy backend:8000
	}

	# /galeria serve dois propósitos: assets de imagem e rota SPA /galeria/:slug.
	# Só interceptamos aqui quando o caminho solicitado é um arquivo real no
	# volume /galeria. Slugs/deep-links inexistentes no filesystem seguem para
	# o fallback SPA abaixo, evitando 404 do Caddy em reload/URL direta.
	@galeria_estatica {
		path /galeria/*
		not path /galeria/
		file {
			root /
			try_files {path}
		}
	}
	handle @galeria_estatica {
		root * /
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	handle_path /fotos/* {
		root * /uploads/fotos
		file_server
		header Cache-Control "public, max-age=300"
	}

	handle_path /logos/* {
		root * /uploads/logos
		file_server
		header Cache-Control "public, max-age=300"
	}

	# Artefatos nativos ficam fora do volume efêmero do frontend. Rotas
	# explícitas impedem que um arquivo ausente caia no fallback da SPA e seja
	# baixado como index.html com extensão .apk/.exe.
	redir /downloads/corvia-os-android.apk /downloads/corvia-cardiology-spaces-android-1.2.0.apk 308
	redir /downloads/corvia-os-android.apk.sha256 /downloads/corvia-cardiology-spaces-android-1.2.0.apk.sha256 308
	redir /downloads/corvia-os-android-1.0.1.apk /downloads/corvia-cardiology-spaces-android-1.2.0.apk 308
	redir /downloads/corvia-os-android-1.0.1.apk.sha256 /downloads/corvia-cardiology-spaces-android-1.2.0.apk.sha256 308
	redir /downloads/corvia-cardiology-spaces-android.apk /downloads/corvia-cardiology-spaces-android-1.2.0.apk 308
	redir /downloads/corvia-cardiology-spaces-android.apk.sha256 /downloads/corvia-cardiology-spaces-android-1.2.0.apk.sha256 308
	redir /downloads/corvia-cardiology-spaces-android-1.1.0.apk /downloads/corvia-cardiology-spaces-android-1.2.0.apk 308
	redir /downloads/corvia-cardiology-spaces-android-1.1.0.apk.sha256 /downloads/corvia-cardiology-spaces-android-1.2.0.apk.sha256 308

	handle /downloads/corvia-cardiology-spaces-android-1.2.0.apk {
		root * /downloads
		rewrite * /corvia-cardiology-spaces-android-1.2.0.apk
		header Content-Type "application/vnd.android.package-archive"
		header Content-Disposition "attachment; filename=CorVIA-Cardiology-Spaces-Android-1.2.0.apk"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /downloads/corvia-cardiology-spaces-android-1.2.0.apk.sha256 {
		root * /downloads
		rewrite * /corvia-cardiology-spaces-android-1.2.0.apk.sha256
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	redir /downloads/corvia-os-windows.zip /downloads/corvia-cardiology-spaces-windows-1.2.0.exe 308
	redir /downloads/corvia-os-windows.exe /downloads/corvia-cardiology-spaces-windows-1.2.0.exe 308
	redir /downloads/corvia-os-windows.exe.sha256 /downloads/corvia-cardiology-spaces-windows-1.2.0.exe.sha256 308

	handle /downloads/corvia-cardiology-spaces-windows-1.2.0.exe {
		root * /downloads
		rewrite * /corvia-cardiology-spaces-windows-1.2.0.exe
		header Content-Type "application/vnd.microsoft.portable-executable"
		header Content-Disposition "attachment; filename=CorVIA-Cardiology-Spaces-Windows-Setup-1.2.0.exe"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /downloads/corvia-cardiology-spaces-windows-1.2.0.exe.sha256 {
		root * /downloads
		rewrite * /corvia-cardiology-spaces-windows-1.2.0.exe.sha256
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Hash de conteúdo: é seguro manter imutável. Cada build gera URLs novas.
	handle_path /assets/* {
		root * /site/assets
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Shell, sw.js, manifest, registerSW e rotas SPA: nunca ficam presos em
	# cache HTTP antigo. A cada abertura/reload o navegador precisa revalidar.
	handle {
		root * /site
		header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		header Pragma "no-cache"
		header Expires "0"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Permitted-Cross-Domain-Policies "none"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' wss: https://*.googleapis.com https://*.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
	}
}
