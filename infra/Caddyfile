# Domínio principal e legado no mesmo bloco.
#
# `{$DOMAIN}` é corvia.med.br. `{$DOMAIN_LEGADO}` é meucardio.med.br, que
# **continua servindo** — quem tem link antigo, favorito ou app instalado não
# pode encontrar porta fechada. O certificado dos dois já foi emitido antes
# desta virada, então não existe janela sem TLS válido.
#
# Desativar o legado é decisão separada e posterior, e quando for feita deve
# ser por redirecionamento permanente, não por desligamento.
{$DOMAIN}, www.{$DOMAIN}, {$DOMAIN_LEGADO} {
	encode gzip zstd

	# API e documentação do backend
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Galeria de imagens — arquivo estático, servido direto (não passa pelo backend)
	handle_path /galeria/* {
		root * /galeria
		file_server
		header Cache-Control "public, max-age=2592000"
	}

	# Foto de perfil enviada pelo usuário. Volume somente-leitura aqui: quem
	# grava é o backend. Cache curto porque a foto pode ser trocada — o nome do
	# arquivo já muda a cada envio, mas o curto evita foto velha após remoção.
	handle_path /fotos/* {
		root * /uploads/fotos
		file_server
		header Cache-Control "public, max-age=300"
	}

	# PWA: arquivos estáticos, com fallback para index.html (rotas do React Router)
	handle {
		root * /site
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
